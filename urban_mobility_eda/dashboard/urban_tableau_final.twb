      </column>
      <column caption='Is Peak Hour' datatype='boolean' name='[Calculation_6256274004079931392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[hour] &gt;= 15 AND [hour] &lt;= 17' />
      </column>
      <column caption='Is Weekend' datatype='boolean' name='[Calculation_7012456529015656449]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[dayofweek] = &quot;Friday&quot; OR [dayofweek] = &quot;Saturday&quot;' />
