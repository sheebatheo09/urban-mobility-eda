        <calculation class='tableau' formula='IF [CHARGELEVELSTART] &lt; 20 THEN &quot;0-20%&quot;&#10;ELSEIF [CHARGELEVELSTART] &lt; 40 THEN &quot;20-40%&quot;&#10;ELSEIF [CHARGELEVELSTART] &lt; 60 THEN &quot;40-60%&quot;&#10;ELSEIF [CHARGELEVELSTART] &lt; 80 THEN &quot;60-80%&quot;&#10;ELSEIF [CHARGELEVELSTART] &lt;= 100 THEN &quot;80-100%&quot;&#10;ELSE &quot;Unknown&quot;&#10;END' />
